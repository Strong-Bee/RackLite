# RackLite Panel Environment Configuration
# Salin file ini menjadi .env lalu sesuaikan nilai rahasia (secrets).

# Rahasia penandatangan JWT session cookie (WAJIB diganti di produksi, minimal 32 karakter acak)
PANEL_JWT_SECRET="change-this-to-a-long-random-64-char-secret-in-production"

# Port server panel (default 3000)
PORT="3000"
HOSTNAME="0.0.0.0"

# Direktori penyimpanan database SQLite, config panel, dan log lokal
PANEL_DATA_DIR="./data"

# Direktori root yang diizinkan untuk File Manager (pisahkan dengan koma jika lebih dari satu)
# Di VPS produksi bisa diatur ke /var/www,/etc/nginx/sites-available,/home
PANEL_FILE_ROOTS="./data/workspace,/var/www"

# Akun admin awal (hanya dibuat saat database pertama kali diinisialisasi)
PANEL_ADMIN_USER="admin"
PANEL_ADMIN_PASS="admin12345"

# URL aplikasi
APP_URL="http://localhost:3000"

# Aktifkan X-Frame-Options: SAMEORIGIN di mode produksi
PANEL_STRICT_FRAME="false"
