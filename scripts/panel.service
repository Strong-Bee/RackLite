[Unit]
Description=RackLite Lightweight Linux Server Panel
Documentation=https://github.com/racklite/panel
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/racklite
EnvironmentFile=/opt/racklite/.env
ExecStart=/usr/bin/npx tsx /opt/racklite/server.ts
Restart=always
RestartSec=3

# Pembatasan sumber daya agar tetap ringan
MemoryMax=256M
LimitNOFILE=65535

# Hardening dasar
NoNewPrivileges=false
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=racklite

[Install]
WantedBy=multi-user.target
